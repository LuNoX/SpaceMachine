{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang-cl"
            }
        },
        {
            "name": "dev",
            "hidden": true,
            "cacheVariables": {
                "SPACEMACHINE_DEV_MODE": "ON"
            }
        },
        {
            "name": "base-debug",
            "hidden": true,
            "inherits": [
                "base",
                "dev"
            ],
            "displayName": "Debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "base-relwithdebinfo",
            "hidden": true,
            "inherits": [
                "base",
                "dev"
            ],
            "displayName": "Release with Debug Info",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "base-release",
            "hidden": true,
            "inherits": "base",
            "displayName": "Release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}